<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurfaceTicket"
    app:cardCornerRadius="16dp"
    app:cardElevation="1.5dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header (票頭: 16dp horizontal, 12dp vertical) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Date Skeleton -->
            <View
                android:id="@+id/viewSkeletonDate"
                android:layout_width="36dp"
                android:layout_height="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Partner Name Skeleton -->
            <View
                android:id="@+id/viewSkeletonPartner"
                android:layout_width="60dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@id/viewSkeletonDate"
                app:layout_constraintStart_toEndOf="@id/viewSkeletonDate"
                app:layout_constraintTop_toTopOf="@id/viewSkeletonDate" />

            <!-- Balance Skeleton -->
            <View
                android:id="@+id/viewSkeletonBalance"
                android:layout_width="40dp"
                android:layout_height="11dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="@id/viewSkeletonAmount"
                app:layout_constraintEnd_toStartOf="@id/viewSkeletonAmount"
                app:layout_constraintTop_toTopOf="@id/viewSkeletonAmount" />

            <!-- Amount Skeleton -->
            <View
                android:id="@+id/viewSkeletonAmount"
                android:layout_width="44dp"
                android:layout_height="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Dashed Divider (折線: 1dp height, 16dp margins) -->
        <com.jasonhong.yoyu.core.widgets.DashedDividerView
            android:id="@+id/dashedDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:alpha="0.4" />

        <!-- Body Skeleton (幾何錨點約束架構，16dp horizontal, 16dp vertical) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- 起點空心圓骨架 (8dp x 8dp) -->
            <View
                android:id="@+id/viewSkeletonTopDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 起點站名骨架 - 垂直中線對齊圓點 -->
            <View
                android:id="@+id/viewSkeletonInLocation"
                android:layout_width="100dp"
                android:layout_height="15dp"
                android:layout_marginStart="14dp"
                app:layout_constraintBottom_toBottomOf="@id/viewSkeletonTopDot"
                app:layout_constraintStart_toEndOf="@id/viewSkeletonTopDot"
                app:layout_constraintTop_toTopOf="@id/viewSkeletonTopDot" />

            <!-- 進站時間骨架 - 垂直中線對齊圓點 -->
            <View
                android:id="@+id/viewSkeletonInTime"
                android:layout_width="36dp"
                android:layout_height="12dp"
                app:layout_constraintBottom_toBottomOf="@id/viewSkeletonTopDot"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/viewSkeletonTopDot" />

            <!-- 垂直軌道連接線骨架 -->
            <View
                android:id="@+id/viewSkeletonTrackLine"
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:alpha="0.4"
                android:background="@color/primary_track"
                app:layout_constraintBottom_toTopOf="@id/viewSkeletonBottomDot"
                app:layout_constraintEnd_toEndOf="@id/viewSkeletonTopDot"
                app:layout_constraintStart_toStartOf="@id/viewSkeletonTopDot"
                app:layout_constraintTop_toBottomOf="@id/viewSkeletonTopDot" />

            <!-- 終點實心圓骨架 (8dp x 8dp) - 下移 22dp -->
            <View
                android:id="@+id/viewSkeletonBottomDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginTop="22dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/viewSkeletonTopDot"
                app:layout_constraintTop_toBottomOf="@id/viewSkeletonTopDot" />

            <!-- 終點站名骨架 - 垂直中線對齊圓點 -->
            <View
                android:id="@+id/viewSkeletonOutLocation"
                android:layout_width="72dp"
                android:layout_height="15dp"
                android:layout_marginStart="14dp"
                app:layout_constraintBottom_toBottomOf="@id/viewSkeletonBottomDot"
                app:layout_constraintStart_toEndOf="@id/viewSkeletonBottomDot"
                app:layout_constraintTop_toTopOf="@id/viewSkeletonBottomDot" />

            <!-- 出站時間骨架 - 垂直中線對齊圓點 -->
            <View
                android:id="@+id/viewSkeletonOutTime"
                android:layout_width="36dp"
                android:layout_height="12dp"
                app:layout_constraintBottom_toBottomOf="@id/viewSkeletonBottomDot"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/viewSkeletonBottomDot" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
