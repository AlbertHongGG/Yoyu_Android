<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurfaceTicket"
    app:cardCornerRadius="16dp"
    app:cardElevation="1.5dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header (票頭: 16dp horizontal, 12dp vertical) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Date -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="09/24" />

            <!-- Partner Name -->
            <TextView
                android:id="@+id/tvPartnerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/primary_subtle"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/tvDate"
                app:layout_constraintEnd_toStartOf="@id/tvBalance"
                app:layout_constraintStart_toEndOf="@id/tvDate"
                app:layout_constraintTop_toTopOf="@id/tvDate"
                tools:text="臺北捷運" />

            <!-- Balance (Aligned Baseline to Amount) -->
            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textColor="@color/text_hint_light"
                android:textSize="11sp"
                app:layout_constraintBaseline_toBaselineOf="@id/tvAmount"
                app:layout_constraintEnd_toStartOf="@id/tvAmount"
                tools:text="餘 $31" />

            <!-- Amount -->
            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="-20"
                tools:textColor="@color/tx_expense_red" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Dashed Divider (折線: 1dp height, 16dp margins) -->
        <com.jasonhong.yoyu.core.widgets.DashedDividerView
            android:id="@+id/dashedDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Body (票面主體: 內容驅動幾何錨點架構，16dp horizontal, 16dp vertical) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- 起點空心圓 (8dp x 8dp) - 垂直居中對齊起點站名 -->
            <View
                android:id="@+id/viewTopDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_transit_top_dot"
                app:layout_constraintBottom_toBottomOf="@id/tvInLocation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvInLocation" />

            <!-- 起點站名 - 物理錨定 parent 頂部，保證 top >= 0，絕不超出邊界被裁切 -->
            <TextView
                android:id="@+id/tvInLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/tvInTime"
                app:layout_constraintStart_toEndOf="@id/viewTopDot"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="台北車站" />

            <!-- 進站時間 - 基準線對齊起點站名 -->
            <TextView
                android:id="@+id/tvInTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                app:layout_constraintBaseline_toBaselineOf="@id/tvInLocation"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="23:07" />

            <!-- 垂直軌道連接線 (2dp width) - 居中對齊圓點並垂直在兩圓點間自動精確拉伸 -->
            <View
                android:id="@+id/viewTrackLine"
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:background="@color/primary_track"
                app:layout_constraintBottom_toTopOf="@id/viewBottomDot"
                app:layout_constraintEnd_toEndOf="@id/viewTopDot"
                app:layout_constraintStart_toStartOf="@id/viewTopDot"
                app:layout_constraintTop_toBottomOf="@id/viewTopDot" />

            <!-- 終點實心圓 (8dp x 8dp) - 垂直居中對齊終點站名，水平對齊起點圓 -->
            <View
                android:id="@+id/viewBottomDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_transit_bottom_dot"
                app:layout_constraintBottom_toBottomOf="@id/tvOutLocation"
                app:layout_constraintEnd_toEndOf="@id/viewTopDot"
                app:layout_constraintStart_toStartOf="@id/viewTopDot"
                app:layout_constraintTop_toTopOf="@id/tvOutLocation" />

            <!-- 終點站名 - 位於起點站名下方，預留自然舒適的乘車行距 (16dp) -->
            <TextView
                android:id="@+id/tvOutLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvOutTime"
                app:layout_constraintStart_toEndOf="@id/viewTopDot"
                app:layout_constraintTop_toBottomOf="@id/tvInLocation"
                tools:text="大橋頭" />

            <!-- 出站時間 - 基準線對齊終點站名 -->
            <TextView
                android:id="@+id/tvOutTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                app:layout_constraintBaseline_toBaselineOf="@id/tvOutLocation"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="23:21" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
