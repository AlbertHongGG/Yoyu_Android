<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurfaceTicket"
    app:cardCornerRadius="16dp"
    app:cardElevation="1.5dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header (票頭: 16dp horizontal, 12dp vertical) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Date -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="09/24" />

            <!-- Partner Name -->
            <TextView
                android:id="@+id/tvPartnerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/primary_subtle"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/tvDate"
                app:layout_constraintEnd_toStartOf="@id/tvBalance"
                app:layout_constraintStart_toEndOf="@id/tvDate"
                app:layout_constraintTop_toTopOf="@id/tvDate"
                tools:text="臺北捷運" />

            <!-- Balance (Aligned Baseline to Amount) -->
            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textColor="@color/text_hint_light"
                android:textSize="11sp"
                app:layout_constraintBaseline_toBaselineOf="@id/tvAmount"
                app:layout_constraintEnd_toStartOf="@id/tvAmount"
                tools:text="餘 $31" />

            <!-- Amount -->
            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="-20"
                tools:textColor="@color/tx_expense_red" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Dashed Divider (折線: 1dp height, 16dp margins) -->
        <com.jasonhong.yoyu.core.widgets.DashedDividerView
            android:id="@+id/dashedDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Body (票面: 3 Column 絕對網格對齊，16dp padding) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Column 1: Graphic (Fixed 30dp width, 40dp height, 8dp circles + 16dp floating line with 4dp gaps) -->
            <LinearLayout
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:gravity="start"
                android:orientation="vertical">

                <!-- Top Hollow Circle (8dp x 8dp) -->
                <View
                    android:id="@+id/viewTopDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_transit_top_dot" />

                <!-- Middle Short Line Segment (2dp width, 16dp height, 4dp gaps, 3dp start margin) -->
                <View
                    android:id="@+id/viewTrackLine"
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/primary_track" />

                <!-- Bottom Solid Circle (8dp x 8dp) -->
                <View
                    android:id="@+id/viewBottomDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_transit_bottom_dot" />

            </LinearLayout>

            <!-- Column 2: Locations (Expanded width, 42dp height, vertical spaceBetween) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="top"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="台北車站" />

                <TextView
                    android:id="@+id/tvOutLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="bottom"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="大橋頭" />

            </LinearLayout>

            <!-- Column 3: Times (Fixed 50dp width, 42dp height, vertical spaceBetween) -->
            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="42dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInTime"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="top|end"
                    android:includeFontPadding="false"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    tools:text="23:07" />

                <TextView
                    android:id="@+id/tvOutTime"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="bottom|end"
                    android:includeFontPadding="false"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    tools:text="23:21" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
