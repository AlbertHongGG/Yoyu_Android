<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Typography Styles (Outfit & Monospace) -->
    <style name="TextAppearance.Yoyu.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/font_outfit</item>
        <item name="android:fontFamily">@font/font_outfit</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TextAppearance.Yoyu.Amount" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/font_outfit</item>
        <item name="android:fontFamily">@font/font_outfit</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="TextAppearance.Yoyu.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/font_outfit</item>
        <item name="android:fontFamily">@font/font_outfit</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TextAppearance.Yoyu.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/font_outfit</item>
        <item name="android:fontFamily">@font/font_outfit</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="TextAppearance.Yoyu.SectionHeader" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/font_outfit</item>
        <item name="android:fontFamily">@font/font_outfit</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="TextAppearance.Yoyu.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">monospace</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- Bottom Sheet Dialog Base Style -->
    <style name="Widget.Yoyu.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
</resources>
