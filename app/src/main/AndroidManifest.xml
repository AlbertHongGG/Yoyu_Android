<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".YoyuApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yoyu">

        <activity
            android:name=".presentation.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/LaunchTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.home.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Yoyu" />

        <activity
            android:name=".presentation.cardface.CardFacePickerActivity"
            android:exported="true"
            android:theme="@style/Theme.Yoyu.SwipeBack" />

        <activity
            android:name=".presentation.detail.CardDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Yoyu.SwipeBack" />

        <!-- 4x2 Home Screen App Widget -->
        <receiver
            android:name=".presentation.widget.CardAppWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="com.jasonhong.yoyu.ACTION_CYCLE_CARD" />
                <action android:name="com.jasonhong.yoyu.ACTION_REFRESH_BALANCE" />
                <action android:name="com.jasonhong.yoyu.ACTION_CARD_DATA_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_card_4x2_info" />
        </receiver>

    </application>

</manifest>
